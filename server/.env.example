# Backend Environment Template
# Rename to .env and fill in your values
# DO NOT COMMIT THIS FILE TO GIT

# Database
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/marketing_ai?retryWrites=true&w=majority

# OpenAI API
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx

# Authentication
JWT_SECRET=your-very-secret-random-string-here-minimum-32-characters

# Environment
NODE_ENV=production

# CORS - Set this to your Vercel frontend URL
CORS_ORIGIN=https://your-project.vercel.app

# Port (Render sets this automatically, only needed for local dev)
PORT=8080
